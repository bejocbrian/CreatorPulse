# API server
PORT=3000

# Example postgres connection string used by the app (via docker-compose)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Example S3-compatible config used by the app (via docker-compose + MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=local
